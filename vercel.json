{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "main": false,
      "codex/integracion-financiera-sollahms": false,
      "codex/recorridos-validos-144": false,
      "codex/mapas-recorridos-auto": false,
      "codex/limpieza-mapas-fichas": false,
      "codex/ecasa-cartera-definitiva": false,
      "codex/leben-brochures-nordico": false,
      "codex/norte-verde-hero-merge": false,
      "codex/sento-cartera-documentada": false,
      "codex/leon-main-integration": false,
      "codex/leon-cartera-preview": false,
      "codex/project-photos-20261025": false,
      "codex/shared-stage-photos-20261025": false,
      "codex/home-patrimonio-20261025": false,
      "codex/home-seo-20261025": false,
      "codex/captacion-20261025": false
    }
  },
  "buildCommand": "node scripts/package-vercel.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nucleo-costanera-2",
      "destination": "/nucleo-costanera.html#etapa-2",
      "permanent": true
    },
    {
