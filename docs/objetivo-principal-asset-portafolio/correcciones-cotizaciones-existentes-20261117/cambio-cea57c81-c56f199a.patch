@@ -0,0 +1,99 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {financialReferenceCompatible} from '../assets/js/catalog-financial-witness.mjs';
+import {projectOffer} from '../assets/js/catalog-model.mjs';
+import {verifiedProjectPrice} from '../assets/js/project-finance.mjs';
+import {advancedFilterAndSort,defaults} from '../assets/js/catalog-filter-engine.mjs';
+
+const projects=JSON.parse(readFileSync(new URL('../data/proyectos.json',import.meta.url)));
+const bcome=projects.find(project=>project.slug==='bcome');
+const facets=JSON.parse(readFileSync(new URL('../data/catalog-facets.json',import.meta.url)));
+
+test('a selected Bcome2D price never displays the financial baseline for Estudio',()=>{
+  const baseline=verifiedProjectPrice(bcome,'2026-11-17');
+  const selected=projectOffer(bcome,{bedrooms:'2'});
+  assert.equal(baseline.valueUf,2930);
+  assert.equal(baseline.typology,'Estudio');
+  assert.equal(selected.value,3855);
+  assert.equal(selected.typology,'2 dormitorios');
+  assert.equal(financialReferenceCompatible(bcome,selected),false);
+});
+
+test('the original Bcome Estudio retains its compatible financial baseline',()=>{
+  assert.equal(financialReferenceCompatible(bcome,projectOffer(bcome)),true);
+});
+
+test('an equal amount never identifies a different typology as the same financial scenario',()=>{
+  // Deliberately synthetic test clone, never a source or catalogue amendment.
+  const copy=structuredClone(bcome);
+  copy.commercialOffers.find(offer=>offer.id==='2d').priceUF=2930;
+  const selected=projectOffer(copy,{bedrooms:'2'});
+  assert.equal(selected.value,2930);
+  assert.equal(financialReferenceCompatible(copy,selected),false);
+});
+
+test('a source without a typology preserves its original amount without null/undefined mismatch',()=>{
+  const project=projects.find(project=>project.slug==='distrito-centro');
+  assert.equal(project.precioDesdeTipologia,undefined);
+  assert.equal(projectOffer(project).value,project.precioDesdeUF);
+  assert.equal(financialReferenceCompatible(project,projectOffer(project)),true);
+});
+
+test('Plaza213 typology price cannot display the separate public313 baseline',()=>{
+  const project=projects.find(project=>project.slug==='plaza-las-condes');
+  const selected=projectOffer(project,{bedrooms:'2'});
+  assert.equal(project.precioDesdeUF,11073);
+  assert.equal(selected.value,11119);
+  assert.equal(financialReferenceCompatible(project,selected),false);
+});
+
+test('AJ selected1D keeps its own price and hides its Estudio financial scenario',()=>{
+  const project=projects.find(project=>project.slug==='edificio-teatinos-750');
+  assert.equal(financialReferenceCompatible(project,projectOffer(project)),true);
+  const selected=projectOffer(project,{bedrooms:'1'});
+  assert.equal(selected.value,3315);
+  assert.equal(financialReferenceCompatible(project,selected),false);
+});
+
+for(const [slug,bedrooms,price,baseline,stage] of [
+  ['ferroparque','0',2240,2360,'ferroparque-2'],
+  ['lomas-de-puyai','2',4220,5260,'lomas-de-puyai-3'],
+  ['terratolten','2',3750,2780,'terratolten-1']
+])test('Ecasa '+stage+' keeps the original project financial baseline separate',()=>{
+  const source=projects.find(project=>project.slug===slug),before=JSON.stringify(source);
+  const query={...defaults(),bedrooms,minPriceInput:String(price),maxPriceInput:String(price)};
+  const matches=advancedFilterAndSort([{...source,_facets:facets.projects[slug]}],query);
+  assert.equal(matches.length,1);
+  assert.equal(matches[0]._ecasaStageSlug,stage);
+  const selected=projectOffer(matches[0],query);
+  assert.equal(source.precioDesdeUF,baseline);
+  assert.equal(selected.value,price);
+  assert.equal(financialReferenceCompatible(source,selected),false);
+  assert.equal(JSON.stringify(source),before);
+});
+
+test('Ecasa reference stage remains compatible when its amount and typology are unchanged',()=>{
+  const source=projects.find(project=>project.slug==='ferroparque');
+  const matches=advancedFilterAndSort([{...source,_facets:facets.projects.ferroparque}],defaults());
+  assert.equal(matches.length,1);
+  assert.equal(matches[0]._ecasaStageSlug,'ferroparque');
+  assert.equal(financialReferenceCompatible(source,projectOffer(matches[0])),true);
+});
+
+test('an explicit incompatible source flag always suppresses the cached scenario',()=>{
+  assert.equal(financialReferenceCompatible(bcome,{value:2930,typology:'Estudio',financialBaselineCompatible:false}),false);
+});
+
+test('missing identity and unknown, zero or invalid amounts never authorize decoration',()=>{
+  assert.equal(financialReferenceCompatible(null,{value:2930,typology:'Estudio'}),false);
+  for(const value of [null,undefined,0,NaN,Infinity,'2930']){
+    assert.equal(financialReferenceCompatible(bcome,{value,typology:'Estudio'}),false);
+  }
+});
+
+test('a compatible flag does not override a different amount or typology',()=>{
+  for(const offer of [{value:3855,typology:'2 dormitorios'},{value:2930,typology:'2 dormitorios'}]){
+    assert.equal(financialReferenceCompatible(bcome,{...offer,financialBaselineCompatible:true}),false);
+  }
+});
diff --git a/tests/catalog-nollagam-integration.test.mjs b/tests/catalog-nollagam-integration.test.mjs
new file mode 100644
index 0000000..c4f38ad
--- /dev/null
+++ b/tests/catalog-nollagam-integration.test.mjs
@@ -0,0 +1,91 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {webcrypto} from 'node:crypto';
+import {loadNollagamOwnerQuoteContexts} from '../assets/js/catalog-nollagam-quote-consumer.mjs';
+import {advancedFilterAndSort,defaults,matchedLabels} from '../assets/js/catalog-filter-engine.mjs';
+import {projectOffer,projectFacts,commercialLayerNote} from '../assets/js/catalog-model.mjs';
+
+const catalogue=JSON.parse(readFileSync(new URL('../data/proyectos.json',import.meta.url)));
+const facets=JSON.parse(readFileSync(new URL('../data/catalog-facets.json',import.meta.url)));
+const ownerBytes=readFileSync(new URL('../data/nollagam-commercial.json',import.meta.url));
+const owner=JSON.parse(ownerBytes);
+const originals=catalogue.map(project=>({...project,_facets:facets.projects[project.slug]}));
+const layer=await loadNollagamOwnerQuoteContexts(originals,{cryptoImpl:webcrypto,fetchImpl:async()=>({
+  ok:true,redirected:false,arrayBuffer:async()=>ownerBytes.buffer.slice(ownerBytes.byteOffset,ownerBytes.byteOffset+ownerBytes.byteLength)
+})});
+const attach=(projects,context=layer)=>projects.map(project=>context.bySlug[project.slug]
+  ?{...project,_nollagamOwnerQuoteContext:context.bySlug[project.slug]}:project);
+const bound=attach(originals),query=patch=>({...defaults(),...patch});
+const one=slug=>bound.filter(project=>project.slug===slug);
+
+for(const [slug,record] of Object.entries(owner.projects))for(const [bedrooms,price] of Object.entries(record.prices)){
+  test('Nollagam application correlates '+slug+' '+bedrooms+'D with owner UF'+price,()=>{
+    const state=query({bedrooms,minPriceInput:String(price),maxPriceInput:String(price)});
+    const rows=advancedFilterAndSort(one(slug),state);
+    assert.equal(rows.length,1);
+    assert.equal(projectOffer(rows[0],state).value,price);
+    assert.equal(projectOffer(rows[0],state).referenceId,'nollagam-owner:'+slug+':'+bedrooms+'d');
+    assert.deepEqual(projectFacts(rows[0],'',state),[{label:'Tipologías',value:bedrooms==='0'?'Estudio':bedrooms==='1'?'1 dormitorio':bedrooms+' dormitorios'}]);
+    assert.match(commercialLayerNote(rows[0],state),/28\/10\/2026/);
+    assert.match(commercialLayerNote(rows[0],state),/no acredita unidad ni stock/);
+    assert.deepEqual(matchedLabels(rows[0],state),[]);
+  });
+}
+
+test('Nollagam never borrows bathroom, type, surface, amenities or extras for its price',()=>{
+  for(const extra of [{bathrooms:'2'},{propertyType:'departamento'},{assetType:'Residencial'},
+    {minArea:'1',areaType:'util'},{amenities:['piscina']},{features:['termopanel']},
+    {parking:'included'},{storage:'available'}]){
+    assert.equal(advancedFilterAndSort(one('costanera-coquimbo-a'),query({
+      bedrooms:'3',minPriceInput:'5000',maxPriceInput:'5100',...extra
+    })).length,0);
+  }
+});
+
+test('Nollagam default identities and published prices remain unchanged when price is inactive',()=>{
+  const before=JSON.stringify(originals);
+  const rows=advancedFilterAndSort(bound,defaults());
+  assert.equal(rows.length,131);
+  assert.deepEqual(rows.map(project=>project.slug),originals.map(project=>project.slug));
+  for(const source of originals){
+    const selected=rows.find(project=>project.slug===source.slug);
+    assert.deepEqual(projectOffer(selected),projectOffer(source));
+  }
+  assert.equal(JSON.stringify(originals),before);
+});
+
+test('five unknown-price categories cannot borrow another category or the project minimum',()=>{
+  let unknowns=0;
+  for(const project of bound.filter(project=>layer.bySlug[project.slug])){
+    for(const reference of layer.bySlug[project.slug].record.references.filter(reference=>reference.attributes.priceUF===null)){
+      unknowns++;
+      assert.equal(advancedFilterAndSort([project],query({bedrooms:String(reference.attributes.bedrooms),minPriceInput:'1'})).length,0);
+    }
+  }
+  assert.equal(unknowns,5);
+});
+
+test('price projection recomputes a changed query rather than borrowing a previous match',()=>{
+  const previous=query({bedrooms:'3',minPriceInput:'5000',maxPriceInput:'5100'});
+  const [result]=advancedFilterAndSort(one('costanera-coquimbo-a'),previous);
+  assert.equal(projectOffer(result,previous).value,5070);
+  const next=query({bedrooms:'2',minPriceInput:'4200',maxPriceInput:'4220'});
+  assert.equal(projectOffer(result,next).value,4210);
+});
+
+test('an attached failed owner source closes active price queries and retains inactive identities',async()=>{
+  const unavailable=await loadNollagamOwnerQuoteContexts(originals,{cryptoImpl:webcrypto,
+    fetchImpl:async()=>({ok:false})});
+  const failed=attach(originals,unavailable);
+  assert.equal(advancedFilterAndSort(failed,defaults()).length,131);
+  assert.equal(advancedFilterAndSort(failed.filter(project=>project.slug==='costanera-coquimbo-a'),query({minPriceInput:'1'})).length,0);
+});
+
+test('price sorting uses selected3D quotes rather than project minima',()=>{
+  const state=query({bedrooms:'3',minPriceInput:'1',sortOrder:'price-asc'});
+  const rows=advancedFilterAndSort(bound.filter(project=>layer.bySlug[project.slug]),state);
+  assert.ok(rows.length>1);
+  const prices=rows.map(project=>projectOffer(project,state).value);
+  assert.deepEqual(prices,[...prices].sort((a,b)=>a-b));
+});
