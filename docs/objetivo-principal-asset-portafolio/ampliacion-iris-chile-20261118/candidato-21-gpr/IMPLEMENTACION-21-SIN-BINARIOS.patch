+    assert len(projects) == 21 and len({p['slug'] for p in projects}) == 21
+    assert not {p['slug'] for p in projects} & {p['slug'] for p in original}
+    icons = json.loads((ROOT / 'data/amenities.json').read_text())['icons']
+    outputs = []
