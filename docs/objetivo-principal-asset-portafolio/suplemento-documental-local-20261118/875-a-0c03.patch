diff --git a/tests/documentary-reference-additions.test.mjs b/tests/documentary-reference-additions.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..964a2b6c0bd13293b40dccd6c2ee0d1c13bba5ef
--- /dev/null
+++ b/tests/documentary-reference-additions.test.mjs
@@ -0,0 +1,142 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {createHash} from 'node:crypto';
+import {createDocumentaryReferenceLayer,DOCUMENTARY_REVIEW_MODE} from '../assets/js/documentary-reference-data.mjs';
+import {loadLocalDocumentaryReview} from '../assets/js/documentary-local-review.mjs';
+import {matchProjectFilters,queryFromCatalogState} from '../assets/js/commercial-filter-engine.mjs';
+import {advancedFilterAndSort,defaults} from '../assets/js/catalog-filter-engine.mjs';
+import {commercialLayerNote,projectOffer} from '../assets/js/catalog-model.mjs';
+
+const read=path=>readFileSync(new URL(path,import.meta.url),'utf8');
+const digest=text=>createHash('sha256').update(text).digest('hex');
+const published=JSON.parse(read('../data/proyectos.json'));
+const additionText=read('./fixtures/iris-documentary-additions-2.json');
+const addition=JSON.parse(additionText);
+const texts={
+  '/tests/fixtures/iris-documentary-15.json':read('./fixtures/iris-documentary-15.json'),
+  '/tests/fixtures/plaza-213-reference.json':read('./fixtures/plaza-213-reference.json'),
+  '/tests/fixtures/iris-documentary-additions-2.json':additionText,
+};
+const location=new URL('http://localhost/proyectos.html?revision_documental=1');
+const admit=async(input=addition)=>{
+  const text=JSON.stringify(input);
+  return createDocumentaryReferenceLayer(published,text,{mode:DOCUMENTARY_REVIEW_MODE,sourceGuard:{sha256:digest(text)}});
+};
+const review=()=>loadLocalDocumentaryReview(published,{location,
+  fetchImpl:async url=>({ok:true,text:async()=>texts[url]})});
+const state=patch=>({...defaults(),evidenceMode:'documentary',...patch});
+const evaluate=(record,patch)=>{
+  const result=matchProjectFilters(record,queryFromCatalogState(state(patch)));
+  assert.deepEqual(result.issues,[]);return result;
+};
+const record=(layer,slug)=>layer.records.find(record=>record.slug===slug);
+
+test('supplement retains the two registered IDs, explicit values and unknown commercial fields',async()=>{
+  const layer=await admit();
+  assert.deepEqual(layer.records.map(record=>record.references[0].id),['IRIS-131-R016','IRIS-131-R017']);
+  assert.deepEqual(layer.records.map(record=>record.slug),['novo-catedral','endemico']);
+  for(const r of layer.records)for(const ref of r.references){
+    assert.equal(ref.stock,null);assert.equal(ref.notOffer,true);
+    for(const key of ['priceUF','usefulM2','interiorM2','totalM2','landM2','privateTerrace','privateGarden','state','delivery'])assert.equal(ref.attributes[key],null);
+    assert.equal(ref.attributes.assetType,undefined);
+  }
+  const novo=record(layer,'novo-catedral').references[0].attributes;
+  assert.equal(novo.bedrooms,null);assert.equal(novo.propertyType,null);assert.equal(novo.bathrooms,1);
+  assert.equal(novo.internalM2,18.44);assert.equal(novo.terraceM2,1.9);
+  const end=record(layer,'endemico').references[0].attributes;
+  assert.equal(end.propertyType,'casa');assert.equal(end.bedrooms,4);assert.equal(end.bathrooms,3);
+  assert.equal(end.internalM2,160);assert.equal(end.terraceM2,0);
+});
+
+test('two new documentary witnesses support only their exact room and terrace predicates',async()=>{
+  const layer=await admit();
+  assert.deepEqual(evaluate(record(layer,'novo-catedral'),{bathrooms:'1',areaType:'terraza',minArea:'1.9',maxArea:'1.9'}).matchedReferenceIds,['IRIS-131-R016']);
+  assert.deepEqual(evaluate(record(layer,'endemico'),{propertyType:'casa',bedrooms:'4',bathrooms:'3',areaType:'terraza',minArea:'0',maxArea:'0'}).matchedReferenceIds,['IRIS-131-R017']);
+  assert.equal(evaluate(record(layer,'novo-catedral'),{bedrooms:'0',bathrooms:'1'}).matches,false);
+  assert.equal(evaluate(record(layer,'novo-catedral'),{propertyType:'estudio'}).matches,false);
+});
+
+test('documentary property does not infer unrecorded asset use',async()=>{
+  const end=record(await admit(),'endemico');
+  assert.equal(evaluate(end,{propertyType:'casa',bedrooms:'4',bathrooms:'3'}).matches,true);
+  assert.equal(evaluate(end,{assetType:'Residencial',propertyType:'casa'}).matches,false);
+  const reference=end.references[0];
+  assert.equal(evaluate({...end,references:[{...reference,attributes:{...reference.attributes,assetType:'Residencial'}}]},
+    {assetType:'Residencial',propertyType:'casa'}).matches,true);
+  for(const sourceKind of ['UNIDAD_UI','published-owner-price'])assert.equal(evaluate({...end,references:[{...reference,sourceKind}]},
+    {assetType:'Residencial',propertyType:'casa'}).matches,true);
+});
+
+test('valid active price and canonical-area queries exclude unknowns without converting Internos',async()=>{
+  const layer=await admit();
+  for(const r of layer.records){
+    assert.equal(evaluate(r,{}).matches,true);
+    for(const query of [{minPriceInput:'1',maxPriceInput:'100000'},...['util','interior','total','terreno'].map(areaType=>({areaType,minArea:'0',maxArea:'100000'}))]){
+      assert.equal(evaluate(r,query).matches,false,JSON.stringify(query));
+    }
+  }
+});
+
+test('supplement records cannot borrow rooms, terraces, owner prices or models from other evidence',async()=>{
+  const loaded=await review(),projects=loaded.projects.filter(project=>['novo-catedral','endemico'].includes(project.slug));
+  for(const patch of [{bedrooms:'4',bathrooms:'1',areaType:'terraza',minArea:'1.9',maxArea:'1.9'},
+    {minPriceInput:'11343',maxPriceInput:'11343',bedrooms:'4',bathrooms:'3'},
+    {search:'D-Molle',bedrooms:'4',bathrooms:'3'}]){
+    projects.forEach(project=>evaluate(project._documentaryRecord,patch));
+    const tainted=projects.map(project=>({...project,precioDesdeUF:11343,descripcionLarga:'D-Molle',
+      _facets:{variants:[{bedrooms:4,bathrooms:3,areas:{util:160}}]}}));
+    assert.deepEqual(advancedFilterAndSort(tainted,state(patch)),[]);
+  }
+});
+
+test('day-only observation and recording time stay separate in documentary metadata and the note',async()=>{
+  const loaded=await review(),project=loaded.projects.find(project=>project.slug==='endemico');
+  const metadata=project._documentaryMetadata.byReferenceId['IRIS-131-R017'];
+  assert.equal(metadata.observedAtUTC,null);assert.equal(metadata.observedOn,'2026-11-17');
+  assert.equal(metadata.recordedAtUTC,'2026-11-17T21:06:11.270281+00:00');
+  assert.equal(metadata.sourceDate,null);assert.equal(metadata.sourceDocumentDate,null);
+  assert.equal(metadata.externalPriceMetadata,undefined);assert.equal(metadata.literalDescription,undefined);
+  const matched=advancedFilterAndSort([project],state({propertyType:'casa',bedrooms:'4',bathrooms:'3'}))[0];
+  const changed={...matched,_documentaryMetadata:{...matched._documentaryMetadata,
+    byReferenceId:{'IRIS-131-R017':{...metadata,recordedAtUTC:'2030-01-02T01:02:03Z'}}}};
+  assert.match(commercialLayerNote(changed,state({})),/Consultada · 17\/11\/2026/);
+  assert.doesNotMatch(commercialLayerNote(changed,state({})),/2030/);
+  assert.equal(projectOffer(matched,state({})).value,null);
+});
+
+test('date guards reject invalid days, missing observations and mismatched precision independently of the pin',async()=>{
+  for(const mutate of [
+    ref=>{ref.observedOn='2026-02-30';},
+    ref=>{ref.observedOn=null;},
+    ref=>{ref.observedOn='2026-11-17T00:00:00Z';},
+    ref=>{ref.recordedAtUTC='not-a-timestamp';},
+    ref=>{ref.sourceDate='2026-11-17';},
+    ref=>{ref.externalPriceMetadata.observedOn='2026-11-18';},
+    ref=>{ref.externalPriceMetadata.observedAtUTC=ref.recordedAtUTC;},
+  ]){
+    const changed=structuredClone(addition);mutate(changed.records[1].references[0]);
+    await assert.rejects(admit(changed),/date/);
+  }
+  const changed=structuredClone(addition);changed.records[0].references[0].observedOn='2026-11-18';
+  await assert.rejects(admit(changed),/date/);
+});
+
+test('loader preserves original16 witnesses while adding two sources with their own pin',async()=>{
+  const loaded=await review();
+  assert.equal(loaded.projects.length,131);assert.equal(loaded.index.documentaryReferenceCount,18);
+  assert.equal(loaded.index.documentaryProjectCount,17);
+  assert.equal(loaded.projects.filter(project=>!project._documentaryRecord.references.length).length,114);
+  const pin=loaded.index.documentarySources.find(source=>source.url.endsWith('iris-documentary-additions-2.json')).sha256;
+  assert.equal(pin,digest(additionText));
+  for(const project of loaded.projects.filter(project=>['novo-catedral','endemico'].includes(project.slug))){
+    const metadata=Object.values(project._documentaryMetadata.byReferenceId)[0];assert.equal(metadata.inputSHA256,pin);
+  }
+  const iris=await createDocumentaryReferenceLayer(published,texts['/tests/fixtures/iris-documentary-15.json'],
