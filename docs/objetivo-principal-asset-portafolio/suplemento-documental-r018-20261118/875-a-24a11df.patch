+
+test('R018 presentation keeps model association, plan metrics and observation date without a commercial price',async()=>{
+  const loaded=await review(),input=state({search:'Vicuña Mackenna 6896',bathrooms:'1',areaType:'util',minArea:'23.69',maxArea:'23.69'});
+  const rows=advancedFilterAndSort(loaded.projects,input);assert.equal(rows.length,1);
