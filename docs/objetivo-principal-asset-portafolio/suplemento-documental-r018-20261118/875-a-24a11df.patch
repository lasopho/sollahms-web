+  assert.equal(Object.hasOwn(input,'externalPriceMetadata'),false);
+  assert.equal(text.includes('3.357'),false);assert.equal(text.includes('3357'),false);
+  const layer=await admit(),reference=layer.records[0].references[0];
+  assert.equal(reference.id,'IRIS-131-R018');assert.equal(reference.stock,null);
+  assert.equal(reference.attributes.propertyType,'departamento');assert.equal(reference.attributes.bathrooms,1);
+  assert.equal(reference.attributes.bedrooms,null);assert.equal(reference.attributes.assetType??null,null);
+  for(const metric of ['internalM2','usefulM2','totalM2'])assert.equal(reference.attributes[metric],23.69);
+  assert.equal(reference.attributes.terraceM2,0);
+  for(const key of ['priceUF','interiorM2','landM2','privateTerrace','privateGarden'])assert.equal(reference.attributes[key],null);
+  assert.equal(reference.explicitPlanMetrics,undefined);assert.equal(reference.modelLabel,undefined);
