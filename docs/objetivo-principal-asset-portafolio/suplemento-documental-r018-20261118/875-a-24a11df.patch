+  ['new interior field',r=>{r.attributes.interiorM2=23.69;}],
+])test('R018 rejects '+name+' independently of fixture pin',async()=>{
+  const changed=structuredClone(fixture);mutate(changed.records[0].references[0],changed);
+  await assert.rejects(admit(changed),TypeError);
