+const location=new URL('http://127.0.0.1/proyectos.html?revision_documental=1');
+const admit=async(input=fixture)=>{
+  const bytes=JSON.stringify(input);
+  return createDocumentaryReferenceLayer(published,bytes,{mode:DOCUMENTARY_REVIEW_MODE,sourceGuard:{sha256:digest(bytes)}});
+};
+const state=patch=>({...defaults(),evidenceMode:'documentary',...patch});
+const evaluate=(record,patch)=>{
+  const result=matchProjectFilters(record,queryFromCatalogState(state(patch)));
+  assert.deepEqual(result.issues,[]);return result;
+};
+const review=fetchImpl=>loadLocalDocumentaryReview(published,{location,
+  fetchImpl:fetchImpl??(async url=>({ok:true,text:async()=>texts[url]}))});
+
+test('R018 fixed pin retains exact source facts with separate plan evidence and no external price metadata',async()=>{
+  assert.equal(digest(text),pin);
