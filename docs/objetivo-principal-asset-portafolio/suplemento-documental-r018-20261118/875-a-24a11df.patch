+test('R018 local loader keeps all131 identities and the earlier18 witnesses unchanged',async()=>{
+  const calls=[],loaded=await review(async(url,options)=>{
+    calls.push(url);assert.deepEqual(options,{cache:'no-store',credentials:'omit',redirect:'error'});
+    return {ok:true,text:async()=>texts[url]};
+  });
+  assert.deepEqual(calls,[...Object.keys(oldPins),path]);
+  assert.equal(loaded.index.documentaryReferenceCount,19);assert.equal(loaded.index.documentaryProjectCount,18);
+  assert.equal(loaded.projects.filter(p=>!p._documentaryRecord.references.length).length,113);
