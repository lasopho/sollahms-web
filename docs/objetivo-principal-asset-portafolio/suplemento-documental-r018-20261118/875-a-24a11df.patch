+test('R018 each canonical field requires its own metadata even when all source numbers happen to agree',async()=>{
+  for(const key of ['usefulM2','totalM2']){
+    const changed=structuredClone(fixture);delete changed.records[0].references[0].explicitPlanMetrics[key];
+    await assert.rejects(admit(changed),/plan metric/);
+    const other=key==='usefulM2'?'totalM2':'usefulM2',partial=structuredClone(fixture);
+    partial.records[0].references[0].attributes[other]=null;
