  "observations": [
    {
      "project": "Bordevivo",
      "detail": "Reframed A/B now expose the black rooftop frame and yellow balcony outside the solid area. C shows the complete facade and street base at desktop; mobile remains readable in all modes."
    },
    {
      "project": "Verne",
      "detail": "A/B desktop are close crops and cut the crown; C retains the full portrait tower and entrance. C is the preferred composition when the full tower matters."
    },
    {
      "project": "Quintavista",
      "detail": "A/B desktop enlarge the 767x532 source around 1.31x; C around 1.09x and mobile C preserves the original aspect ratio. Native resolution remains a source limitation."
    },
    {
      "project": "Playa Serena",
      "detail": "Main pointed corner and cantilevered balconies are recognisable in all modes. A emphasizes the tower, C keeps more sky and street base."
    },
    {
      "project": "Vicuña Mackenna 6896",
      "detail": "All three modes wrap the long title without clipping at tablet and mobile, entirely on solid green."
    }
  ],
