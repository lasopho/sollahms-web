+ ['Bold608 no concilia T3,71','edificio-bold',{surfaces:{terrace:{min:3.71,max:3.71}}},false,'UI:edificio-bold:608'],
+ ['Bold608 conserva terraza privada','edificio-bold',{privateTerrace:true},true,'UI:edificio-bold:608'],
