+
+/* Preserve typography and link treatment after lifting coverage out of advisory-copy. */
+.agenda-coverage h2{font-family:Manrope,sans-serif;line-height:1.1;font-weight:600;letter-spacing:-.045em;margin:1rem 0 1.5rem}
+.agenda-coverage a{color:var(--s-green);text-decoration:underline;text-underline-offset:.2em}
+.agenda-coverage .advisory-help{font-size:.78rem;line-height:1.65;color:var(--s-muted);margin:.45rem 0}
