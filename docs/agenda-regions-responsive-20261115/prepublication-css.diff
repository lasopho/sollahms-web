 /* Agenda only; shared advisory/form styles remain untouched. */
-.agenda-coverage{margin-top:3rem;padding-top:2rem;border-top:1px solid var(--s-line)}
+.agenda-coverage{grid-column:1 / -1;min-width:0;margin-top:0;padding-top:2rem;border-top:1px solid var(--s-line)}
 .agenda-coverage h2{font-size:clamp(1.65rem,2.4vw,2rem);max-width:24ch}
 .agenda-coverage>p{color:var(--s-muted);line-height:1.8}
-.agenda-regions{display:grid;gap:1rem;margin:1.5rem 0}
-.agenda-region{padding:1.25rem;background:var(--s-white);border:1px solid var(--s-line);border-radius:var(--s-radius)}
+.agenda-regions{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));align-items:stretch;gap:1rem;margin:1.5rem 0}
+.agenda-region{min-width:0;padding:1.25rem;background:var(--s-white);border:1px solid var(--s-line);border-radius:var(--s-radius)}
 .agenda-region h3{font:700 1.05rem/1.4 Manrope,sans-serif;margin:0 0 .75rem;color:var(--s-green)}
-.agenda-region ul{margin:0;padding-left:1.2rem;columns:2;column-gap:1.5rem;font-size:.92rem;line-height:1.6}
+.agenda-region ul{margin:0;padding-left:1.2rem;columns:9rem;column-gap:1.5rem;font-size:.92rem;line-height:1.6}
 .agenda-region li{break-inside:avoid;margin-bottom:.45rem;overflow-wrap:anywhere}
-@media(max-width:767px){.agenda-region ul{columns:1}.agenda-coverage .advisory-jump{min-height:44px;padding:.7rem 0}.agenda-coverage{margin-top:2rem}}
